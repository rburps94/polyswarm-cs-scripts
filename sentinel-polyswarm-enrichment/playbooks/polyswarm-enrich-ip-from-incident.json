{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "title": "PolySwarm - IP Association Enrichment - Incident Triggered",
    "description": "Takes every IP entity on a Microsoft Sentinel incident and asks PolySwarm which analysed artifacts have been observed in association with it, writing the association count and a sample of hashes back to the incident as a comment.",
    "prerequisites": [
      "A PolySwarm API key with access to the target community. Get one at https://polyswarm.network/account/api-keys"
    ],
    "postDeployment": [
      "1. Assign the 'Microsoft Sentinel Responder' role on the resource group (or workspace) to this playbook's system-assigned managed identity.",
      "2. Authorize the Microsoft Sentinel API connection if it shows as unauthorized.",
      "3. Attach the playbook to an automation rule so it runs when an incident is created.",
      "4. Read the note on interpretation in the comment output before acting on results: association is a pivot lead, not a verdict."
    ],
    "entities": [
      "Ip"
    ],
    "tags": [
      "Enrichment"
    ],
    "support": {
      "tier": "community"
    },
    "author": {
      "name": "PolySwarm Customer Success"
    }
  },
  "parameters": {
    "PlaybookName": {
      "type": "string",
      "defaultValue": "PolySwarm-Enrich-IP-IncidentTriggered",
      "metadata": {
        "description": "Name of the Logic App playbook resource."
      }
    },
    "PolySwarmApiKey": {
      "type": "securestring",
      "metadata": {
        "description": "PolySwarm API key. Sent verbatim as the Authorization header (no 'Bearer ' prefix)."
      }
    },
    "PolySwarmCommunity": {
      "type": "string",
      "defaultValue": "default",
      "metadata": {
        "description": "PolySwarm community to search."
      }
    },
    "PolySwarmApiBaseUrl": {
      "type": "string",
      "defaultValue": "https://api.polyswarm.network/v3",
      "metadata": {
        "description": "PolySwarm REST API v3 base URL."
      }
    },
    "SampleHashCount": {
      "type": "int",
      "defaultValue": 10,
      "minValue": 1,
      "maxValue": 50,
      "metadata": {
        "description": "How many associated SHA256 hashes to list in the incident comment. The API returns up to 'limit' per page; this only controls how many are shown."
      }
    }
  },
  "variables": {
    "AzureSentinelConnectionName": "[concat('MicrosoftSentinel-', parameters('PlaybookName'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[variables('AzureSentinelConnectionName')]",
      "location": "[resourceGroup().location]",
      "kind": "V1",
      "properties": {
        "displayName": "[variables('AzureSentinelConnectionName')]",
        "customParameterValues": {},
        "parameterValueType": "Alternative",
        "api": {
          "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', resourceGroup().location, '/managedApis/azuresentinel')]"
        }
      }
    },
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2017-07-01",
      "name": "[parameters('PlaybookName')]",
      "location": "[resourceGroup().location]",
      "tags": {
        "LogicAppsCategory": "security",
        "hidden-SentinelTemplateName": "PolySwarm-Enrich-IP",
        "hidden-SentinelTemplateVersion": "1.0"
      },
      "identity": {
        "type": "SystemAssigned"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/connections', variables('AzureSentinelConnectionName'))]"
      ],
      "properties": {
        "state": "Enabled",
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "$connections": {
              "type": "Object",
              "defaultValue": {}
            },
            "PolySwarmApiKey": {
              "type": "securestring"
            },
            "PolySwarmCommunity": {
              "type": "string",
              "defaultValue": "default"
            },
            "PolySwarmApiBaseUrl": {
              "type": "string",
              "defaultValue": "https://api.polyswarm.network/v3"
            },
            "SampleHashCount": {
              "type": "int",
              "defaultValue": 10
            }
          },
          "triggers": {
            "Microsoft_Sentinel_incident": {
              "type": "ApiConnectionWebhook",
              "inputs": {
                "body": {
                  "callback_url": "@{listCallbackUrl()}"
                },
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                  }
                },
                "path": "/incident-creation"
              }
            }
          },
          "actions": {
            "Entities_-_Get_IPs": {
              "type": "ApiConnection",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                  }
                },
                "method": "post",
                "path": "/entities/ip",
                "body": "@triggerBody()?['object']?['properties']?['relatedEntities']"
              },
              "runAfter": {}
            },
            "For_each_ip": {
              "type": "Foreach",
              "foreach": "@body('Entities_-_Get_IPs')?['IPs']",
              "runAfter": {
                "Entities_-_Get_IPs": [
                  "Succeeded"
                ]
              },
              "runtimeConfiguration": {
                "concurrency": {
                  "repetitions": 1
                }
              },
              "actions": {
                "Search_PolySwarm_ioc": {
                  "type": "Http",
                  "description": "Returns a flat array of SHA256 strings for artifacts observed in association with this IP. Paginated: has_more with an offset token means more pages exist.",
                  "inputs": {
                    "method": "GET",
                    "uri": "@{parameters('PolySwarmApiBaseUrl')}/ioc/search",
                    "queries": {
                      "ip": "@{trim(items('For_each_ip')?['Address'])}",
                      "community": "@parameters('PolySwarmCommunity')",
                      "limit": "50"
                    },
                    "headers": {
                      "Authorization": "@parameters('PolySwarmApiKey')",
                      "Accept": "application/json"
                    },
                    "retryPolicy": {
                      "type": "exponential",
                      "count": 3,
                      "interval": "PT10S"
                    }
                  },
                  "runtimeConfiguration": {
                    "secureData": {
                      "properties": [
                        "inputs"
                      ]
                    }
                  },
                  "runAfter": {}
                },
                "If_lookup_succeeded": {
                  "type": "If",
                  "expression": {
                    "equals": [
                      "@outputs('Search_PolySwarm_ioc')?['statusCode']",
                      200
                    ]
                  },
                  "runAfter": {
                    "Search_PolySwarm_ioc": [
                      "Succeeded",
                      "Failed"
                    ]
                  },
                  "actions": {
                    "Build_summary": {
                      "type": "Compose",
                      "description": "result is a flat array of SHA256 strings, not objects. hasMore indicates the count shown is a page, not a total.",
                      "inputs": {
                        "hashes": "@coalesce(body('Search_PolySwarm_ioc')?['result'], json('[]'))",
                        "count": "@length(coalesce(body('Search_PolySwarm_ioc')?['result'], json('[]')))",
                        "hasMore": "@coalesce(body('Search_PolySwarm_ioc')?['has_more'], false)"
                      },
                      "runAfter": {}
                    },
                    "Add_enrichment_comment_to_incident": {
                      "type": "ApiConnection",
                      "inputs": {
                        "host": {
                          "connection": {
                            "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                          }
                        },
                        "method": "post",
                        "path": "/Incidents/Comment",
                        "body": {
                          "incidentArmId": "@triggerBody()?['object']?['id']",
                          "message": "<p><strong>PolySwarm IP association</strong><br>\nIP: @{items('For_each_ip')?['Address']}<br>\n@{if(equals(outputs('Build_summary')?['count'], 0), 'No analysed artifacts in the PolySwarm corpus are associated with this address.', concat('Associated artifacts: ', string(outputs('Build_summary')?['count']), if(equals(outputs('Build_summary')?['hasMore'], true), '+ (first page only, more available)', ''), '<br>\n', 'Sample: ', join(take(outputs('Build_summary')?['hashes'], parameters('SampleHashCount')), '<br>\n'), '<br>\n'))}</p><p><em>Interpretation: association means these artifacts were observed contacting this address during analysis. It is a pivot lead, not a verdict. Shared infrastructure and public services accumulate large association counts without being malicious &mdash; a query for 8.8.8.8 fills a page &mdash; so weigh the count against how specific the address is before acting.</em></p>"
                        }
                      },
                      "runAfter": {
                        "Build_summary": [
                          "Succeeded"
                        ]
                      }
                    }
                  },
                  "else": {
                    "actions": {
                      "Add_no_result_comment_to_incident": {
                        "type": "ApiConnection",
                        "inputs": {
                          "host": {
                            "connection": {
                              "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                            }
                          },
                          "method": "post",
                          "path": "/Incidents/Comment",
                          "body": {
                            "incidentArmId": "@triggerBody()?['object']?['id']",
                            "message": "<p><strong>PolySwarm IP association</strong><br>\nIP: @{items('For_each_ip')?['Address']}<br>\nLookup did not succeed. HTTP status: @{coalesce(outputs('Search_PolySwarm_ioc')?['statusCode'], 'no response')}.</p>"
                          }
                        },
                        "runAfter": {}
                      }
                    }
                  }
                }
              }
            }
          },
          "outputs": {}
        },
        "parameters": {
          "$connections": {
            "value": {
              "azuresentinel": {
                "connectionId": "[resourceId('Microsoft.Web/connections', variables('AzureSentinelConnectionName'))]",
                "connectionName": "[variables('AzureSentinelConnectionName')]",
                "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', resourceGroup().location, '/managedApis/azuresentinel')]",
                "connectionProperties": {
                  "authentication": {
                    "type": "ManagedServiceIdentity"
                  }
                }
              }
            }
          },
          "PolySwarmApiKey": {
            "value": "[parameters('PolySwarmApiKey')]"
          },
          "PolySwarmCommunity": {
            "value": "[parameters('PolySwarmCommunity')]"
          },
          "PolySwarmApiBaseUrl": {
            "value": "[parameters('PolySwarmApiBaseUrl')]"
          },
          "SampleHashCount": {
            "value": "[parameters('SampleHashCount')]"
          }
        }
      }
    }
  ],
  "outputs": {
    "playbookResourceId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Logic/workflows', parameters('PlaybookName'))]"
    },
    "managedIdentityPrincipalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Logic/workflows', parameters('PlaybookName')), '2017-07-01', 'full').identity.principalId]"
    }
  }
}
